# copy to ~/.config/rfs/hub.env, chmod 600
RFS_ACCESS_TEAM=yourteam          # https://<yourteam>.cloudflareaccess.com
RFS_ACCESS_AUD=                   # Access app > Overview > Application Audience (AUD) Tag
TUNNEL_TOKEN=                     # Zero Trust > Networks > Tunnels > your tunnel > token
RFS_AUDIT_LOG=/home/you/.local/state/rfs/audit.log   # one JSON line per API request; omit to log to stderr
